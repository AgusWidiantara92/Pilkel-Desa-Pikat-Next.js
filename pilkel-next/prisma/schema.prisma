datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tps {
  id            Int      @id @default(autoincrement())
  nomor_tps     String   @unique
  nama_lokasi   String
  dusun         String?
  kuota_pemilih Int      @default(0)
  keterangan    String?
  voters        Voter[]
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("tps")
}

model Voter {
  id                Int       @id @default(autoincrement())
  nkk               String
  nik               String    @unique
  nama              String
  tempat_lahir      String?
  tanggal_lahir     String?
  jenis_kelamin     String    // L / P
  status_perkawinan String    @default("B") // B / S / P
  alamat            String?
  dusun             String?
  tps_id            Int
  tps               Tps       @relation(fields: [tps_id], references: [id], onDelete: Cascade)
  status            String    @default("aktif") // aktif / tms
  keterangan        String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@map("voters")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  email_verified_at DateTime?
  password          String
  remember_token    String?
  role              String    @default("user")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@map("users")
}
